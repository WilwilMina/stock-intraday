# Backend configuration. Every variable is optional; the values below are the
# defaults used when a variable is unset. The server reads the process
# environment directly (no .env loader), so override by setting variables in
# your shell, e.g. `PORT=4000 npm run dev`.

# Port the API listens on.
PORT=3000

# Base URL of the Yahoo Finance chart API (no trailing slash).
YAHOO_BASE_URL=https://query1.finance.yahoo.com

# Timeout for each outbound Yahoo request, in milliseconds.
REQUEST_TIMEOUT_MS=5000

# Comma-separated list of browser origins allowed by CORS. The default is the
# Vite dev server. The dev proxy avoids CORS entirely, so this only matters
# when the frontend calls the API from a different origin.
CORS_ORIGIN=http://localhost:5173
